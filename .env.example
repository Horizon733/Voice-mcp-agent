# Copy to .env and adjust. Works for local runs and docker compose.

# --- Caches (local native runs; Docker uses /data/* via compose) ---
# Windows example:
# HF_HOME=D:\hf-cache
# TORCH_HOME=D:\torch-cache
# Mac example:
# HF_HOME=/Users/you/.cache/mcp-voice/hf
# TORCH_HOME=/Users/you/.cache/mcp-voice/torch

# --- Devices ---
# STT stays on CPU by default (saves GPU/MPS for TTS).
STT_DEVICE=cpu
# auto | cuda | mps | cpu
#   Windows+NVIDIA: cuda or auto
#   Mac Apple Silicon: mps or auto
#   Docker default compose: cpu
TTS_DEVICE=auto
# turbo (lighter, recommended) | full
TTS_BACKEND=turbo
# Normalize reply text before TTS to keep pronunciation stable in English.
TTS_NORMALIZE_ENGLISH=true
# Spoken-output compaction before synthesis (lower = faster TTS).
TTS_MAX_CHARS=240
TTS_MAX_SENTENCES=3
# Prime the TTS model once at startup to reduce first-turn latency.
TTS_WARMUP_ENABLED=true
TTS_WARMUP_TEXT=Ready, sir.

# faster-whisper model size
WHISPER_MODEL=medium.en

# STT tuning:
# STT_PROFILE=fast|balanced|accurate
# STT_COMPUTE_TYPE=auto|int8|int8_float16|float16|float32
# STT_LANGUAGE=en|auto
# STT_VAD_FILTER=true|false
# STT_BEAM_SIZE=1..5
STT_PROFILE=balanced
STT_COMPUTE_TYPE=auto
STT_LANGUAGE=en
STT_VAD_FILTER=true
STT_BEAM_SIZE=2

# Lower-memory option:
# WHISPER_MODEL=small.en
# STT_PROFILE=fast

# Voice paths (relative to repo root for local; compose overrides inside container)
JARVIS_REF_WAV=voices/jarvis-5s.wav
JARVIS_CONDS=voices/jarvis_conds.pt

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq fallback (used only when Gemini fails; includes tool-calling for web_search/notes) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Optional custom endpoint for OpenAI-compatible Groq API
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SEC=25

# Notes DB (things the user asked Jarvis to remember)
NOTES_DB_PATH=data/notes.db

# React / frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Optional spoken-style system prompt override (Jarvis persona is the default in config.py)
# SYSTEM_PROMPT=You are J.A.R.V.I.S....

# Default assistant response language for text sent to TTS.
# Use English unless you intentionally want multilingual responses.
ASSISTANT_LANGUAGE=English
